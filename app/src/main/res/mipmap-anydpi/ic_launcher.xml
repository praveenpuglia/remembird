<?xml version="1.0" encoding="utf-8"?>
<!-- Insets centre the bird (heart included) inside the 66/108 safe zone, so circle masks don't clip it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/kraft" />
    <foreground>
        <inset android:insetLeft="23%" android:insetTop="22.3%" android:insetRight="25.9%" android:insetBottom="26.6%">
            <layer-list>
                <item android:drawable="@drawable/bird_sticker" />
                <item android:drawable="@drawable/bird" />
            </layer-list>
        </inset>
    </foreground>
    <monochrome>
        <inset android:drawable="@drawable/bird_line" android:insetLeft="23%" android:insetTop="22.3%" android:insetRight="25.9%" android:insetBottom="26.6%" />
    </monochrome>
</adaptive-icon>
